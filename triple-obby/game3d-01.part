  (() => {
    const stageText = document.getElementById('stageText');
    const timerText = document.getElementById('timerText');
    const bestText = document.getElementById('bestText');
    const mapName = document.getElementById('mapName');
    const mapDesc = document.getElementById('mapDesc');
    const hud = document.getElementById('hud');
    const lobbyOverlay = document.getElementById('lobbyOverlay');
    const mobileControls = document.getElementById('mobileControls');
    const toast = document.getElementById('toast');
    const finishOverlay = document.getElementById('finishOverlay');
    const resultTime = document.getElementById('resultTime');
    const resultBest = document.getElementById('resultBest');
    const finishMessage = document.getElementById('finishMessage');
    const viewBtn = document.getElementById('viewBtn');
    const viewModeText = document.getElementById('viewModeText');

    const CAMERA_MODES = [
      { id: 'third', label: '3인칭', fov: 65 },
      { id: 'first', label: '1인칭', fov: 76 },
      { id: 'top', label: '탑뷰', fov: 58 },
    ];

    const MAPS = {
      color: { name: '컬러 점프맵 3D', stages: 20, desc: '컬러 플랫폼과 금 간 사라지는 블록을 통과하세요.' },
      lava: { name: '용암 타워 3D', stages: 18, desc: '바닥과 장애물 모두 킬 요소인 용암 타워를 오르세요.' },
      sky: { name: '하늘섬 리메이크 3D', stages: 20, desc: '공중섬 구조를 전면 리메이크한 스피드런형 3D 하늘섬입니다.' },
    };

    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(0x9dd9ff, 35, 180);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
    renderer.setSize(innerWidth, innerHeight);
    document.body.appendChild(renderer.domElement);

    const camera = new THREE.PerspectiveCamera(65, innerWidth / innerHeight, 0.1, 1000);
    camera.position.set(0, 8, 14);

    const hemi = new THREE.HemisphereLight(0xffffff, 0x446688, 1.15);
    scene.add(hemi);
    const dir = new THREE.DirectionalLight(0xffffff, 1.05);
    dir.position.set(16, 24, 10);
    dir.castShadow = true;
    dir.shadow.mapSize.set(2048, 2048);
    dir.shadow.camera.left = -80;
    dir.shadow.camera.right = 80;
    dir.shadow.camera.top = 80;
    dir.shadow.camera.bottom = -80;
    scene.add(dir);

    const worldRoot = new THREE.Group();
    scene.add(worldRoot);

    const player = {
      pos: new THREE.Vector3(0, 2, 0),
      vel: new THREE.Vector3(),
      radius: 0.42,
      height: 1.8,
      grounded: false,
      yaw: 0,
      checkpoint: new THREE.Vector3(0, 2, 0),
      stage: 1,
      mapId: null,
      jumpBuffer: 0,
      coyote: 0,
      boost: 0,
      finishCooldown: 0
    };

    const input = {
      forward: false, back: false, left: false, right: false, jump: false, jumpPressed: false, sprint: false
    };

    const state = {
      mode: 'lobby',
      elapsed: 0,
      toastUntil: 0,
      level: null,
      particles: [],
      confetti: [],
      lastTime: performance.now() / 1000,
      cameraTarget: new THREE.Vector3(),
      cameraMode: 'third',
    };

    const playerGroup = new THREE.Group();
    const bodyMat = new THREE.MeshStandardMaterial({ color: 0xff4fb2, roughness: 0.5 });
    const headMat = new THREE.MeshStandardMaterial({ color: 0xffddb9, roughness: 0.65 });
    const hairMat = new THREE.MeshStandardMaterial({ color: 0x211a22, roughness: 0.8 });
    const body = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.95, 0.6), bodyMat);
    body.position.y = 1.05;
    body.castShadow = true;
    const head = new THREE.Mesh(new THREE.BoxGeometry(0.72, 0.52, 0.62), headMat);
    head.position.y = 1.85;
    head.castShadow = true;
    const hair = new THREE.Mesh(new THREE.BoxGeometry(0.74, 0.2, 0.64), hairMat);
    hair.position.y = 2.08;
    hair.castShadow = true;
    const leg1 = new THREE.Mesh(new THREE.BoxGeometry(0.24, 0.8, 0.24), bodyMat.clone());
    const leg2 = leg1.clone();
    leg1.position.set(-0.18, 0.38, 0); leg2.position.set(0.18, 0.38, 0);
    leg1.castShadow = true; leg2.castShadow = true;
    playerGroup.add(body, head, hair, leg1, leg2);
    worldRoot.add(playerGroup);

    const particleGeo = new THREE.SphereGeometry(0.08, 8, 8);

    function fmt(ms) {
      if (!Number.isFinite(ms)) return '--:--.---';
      const t = Math.max(0, Math.floor(ms));
      const m = Math.floor(t / 60000);
      const s = Math.floor((t % 60000) / 1000);
      const z = t % 1000;
      return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0') + '.' + String(z).padStart(3, '0');
    }
    function getBestKey(id) { return 'tripleObby3D.best.' + id; }
    function getBest(id) {
      const n = Number(localStorage.getItem(getBestKey(id)) || 'Infinity');
      return Number.isFinite(n) ? n : Infinity;
    }
    function setBest(id, value) {
      const old = getBest(id);
      if (value < old) localStorage.setItem(getBestKey(id), String(Math.floor(value)));
      return Math.min(old, value);
    }
    function showToast(text, seconds = 1) {
      toast.textContent = text;
      toast.dataset.visible = 'true';
      state.toastUntil = performance.now() / 1000 + seconds;
    }

    function setCameraMode(modeId, announce = true) {
      const mode = CAMERA_MODES.find(item => item.id === modeId) || CAMERA_MODES[0];
      state.cameraMode = mode.id;
      viewModeText.textContent = mode.label;
      viewBtn.setAttribute('aria-label', '시점 변경. 현재 ' + mode.label);
      camera.fov = mode.fov;
      camera.updateProjectionMatrix();
      playerGroup.visible = mode.id !== 'first';
      if (announce) showToast('시점: ' + mode.label, 0.75);
    }

    function cycleCameraMode() {
      const current = CAMERA_MODES.findIndex(item => item.id === state.cameraMode);
      const next = CAMERA_MODES[(current + 1) % CAMERA_MODES.length];
      setCameraMode(next.id);
    }
    function hideToastIfNeeded(now) {
      if (state.toastUntil && now >= state.toastUntil) toast.dataset.visible = 'false';
    }

    function clearLevel() {
      while (worldRoot.children.length > 1) {
        const obj = worldRoot.children[1];
        worldRoot.remove(obj);
      }
      state.level = null;
      scene.background = new THREE.Color(0x0a1a35);
      scene.fog.color.set(0x9dd9ff);
    }

    function makeBox(size, color, pos, opts = {}) {
      const mat = new THREE.MeshStandardMaterial({ color, roughness: opts.roughness ?? 0.55, metalness: opts.metalness ?? 0.08, transparent: !!opts.transparent, opacity: opts.opacity ?? 1 });
      const mesh = new THREE.Mesh(new THREE.BoxGeometry(size.x, size.y, size.z), mat);
      mesh.position.copy(pos);
      mesh.receiveShadow = opts.receiveShadow !== false;
      mesh.castShadow = opts.castShadow !== false;
      if (opts.rotationY) mesh.rotation.y = opts.rotationY;
      return mesh;
    }

    function createCrackLines(w, d, y) {
      const points = [];
      const pathSets = [
        [[-w * 0.35, 0, -d * 0.2], [-w * 0.1, 0, -d * 0.05], [w * 0.05, 0, d * 0.15], [w * 0.28, 0, d * 0.26]],
        [[-w * 0.15, 0, d * 0.28], [-w * 0.04, 0, d * 0.06], [w * 0.1, 0, -d * 0.15], [w * 0.24, 0, -d * 0.28]],
        [[-w * 0.02, 0, -d * 0.34], [w * 0.02, 0, -d * 0.16], [w * 0.09, 0, 0.02], [w * 0.16, 0, d * 0.2]]
      ];
      pathSets.forEach(path => {
        for (let i = 0; i < path.length - 1; i++) {
          points.push(new THREE.Vector3(path[i][0], y, path[i][2]), new THREE.Vector3(path[i + 1][0], y, path[i + 1][2]));
        }
      });
      const geo = new THREE.BufferGeometry().setFromPoints(points);
      const mat = new THREE.LineBasicMaterial({ color: 0x2f2434, transparent: true, opacity: 0.75 });
      const lines = new THREE.LineSegments(geo, mat);
      return lines;
    }

