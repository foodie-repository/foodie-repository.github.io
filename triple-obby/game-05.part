    if (p.kind === "crumble" && p.triggerAt > 0) alpha = .35 + .65 * Math.abs(Math.sin((time - p.triggerAt) * 18));
    ctx.globalAlpha = alpha;
    ctx.shadowColor = p.color;
    ctx.shadowBlur = ["checkpoint", "finish", "bounce", "speed"].includes(p.kind) ? 20 : 8;

    if (game.mapId === "sky" && !["checkpoint", "finish", "hazardMove"].includes(p.kind)) {
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(s.x + 18, s.y + 8, 19, 0, TAU);
      ctx.arc(s.x + p.w * .45, s.y, 25, 0, TAU);
      ctx.arc(s.x + p.w * .72, s.y + 5, 22, 0, TAU);
      ctx.arc(s.x + p.w - 15, s.y + 10, 17, 0, TAU);
      ctx.fillRect(s.x + 12, s.y + 8, p.w - 24, p.h + 4);
      ctx.fill();
    } else {
      const grad = ctx.createLinearGradient(s.x, s.y, s.x, s.y + p.h);
      grad.addColorStop(0, p.color);
      grad.addColorStop(1, shadeColor(p.color, -.22));
      ctx.fillStyle = grad;
      roundedRect(s.x, s.y, p.w, p.h, Math.min(10, p.h / 2)); ctx.fill();
      ctx.fillStyle = "rgba(255,255,255,.28)";
      roundedRect(s.x + 4, s.y + 3, Math.max(0, p.w - 8), Math.min(5, p.h - 3), 3); ctx.fill();
    }
    ctx.shadowBlur = 0;

    if (p.kind === "checkpoint") {
      ctx.fillStyle = "rgba(255,255,255,.88)"; ctx.font = "900 11px system-ui"; ctx.textAlign = "center";
      ctx.fillText(String(p.stage), s.x + p.w / 2, s.y - 12);
      ctx.strokeStyle = "rgba(255,255,255,.75)"; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(s.x + p.w / 2, s.y); ctx.lineTo(s.x + p.w / 2, s.y - 42); ctx.stroke();
      ctx.fillStyle = p.color; ctx.beginPath(); ctx.moveTo(s.x + p.w / 2, s.y - 42); ctx.lineTo(s.x + p.w / 2 + 32, s.y - 30); ctx.lineTo(s.x + p.w / 2, s.y - 18); ctx.fill();
    } else if (p.kind === "finish") {
      ctx.fillStyle = "#fff"; ctx.font = "1000 15px system-ui"; ctx.textAlign = "center"; ctx.fillText(p.label || "FINISH", s.x + p.w / 2, s.y - 18);
      for (let i = 0; i < 8; i++) {
        ctx.fillStyle = (i + Math.floor(time * 4)) % 2 ? "#111" : "#fff";
        ctx.fillRect(s.x + 25 + i * ((p.w - 50) / 8), s.y - 62, (p.w - 50) / 8 + 1, 25);
      }
      ctx.strokeStyle = "white"; ctx.lineWidth = 4; ctx.strokeRect(s.x + 24, s.y - 64, p.w - 48, 54);
    } else if (p.kind === "conveyor") {
      ctx.fillStyle = "rgba(0,0,0,.4)"; ctx.font = "900 15px system-ui"; ctx.textAlign = "center";
      ctx.fillText(p.direction > 0 ? "▶ ▶ ▶" : "◀ ◀ ◀", s.x + p.w / 2, s.y + 17);
    } else if (p.kind === "bounce") {
      ctx.fillStyle = "rgba(0,0,0,.45)"; ctx.font = "1000 18px system-ui"; ctx.textAlign = "center"; ctx.fillText("↑", s.x + p.w / 2, s.y + 18);
    } else if (p.kind === "speed") {
      ctx.fillStyle = "rgba(0,0,0,.45)"; ctx.font = "1000 14px system-ui"; ctx.textAlign = "center"; ctx.fillText("BOOST ▶", s.x + p.w / 2, s.y + 17);
    } else if (p.kind === "hazardMove") {
      ctx.fillStyle = p.color;
      for (let x = 0; x < p.w; x += 18) {
        ctx.beginPath(); ctx.moveTo(s.x + x, s.y + p.h); ctx.lineTo(s.x + x + 9, s.y - 14); ctx.lineTo(s.x + x + 18, s.y + p.h); ctx.fill();
      }
    } else if (p.kind === "crumble") {
      ctx.strokeStyle = "rgba(0,0,0,.38)"; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(s.x + p.w * .25, s.y + 2); ctx.lineTo(s.x + p.w * .45, s.y + p.h - 2); ctx.lineTo(s.x + p.w * .62, s.y + 5); ctx.stroke();
    }
    ctx.restore();
  }

  function shadeColor(color, amount) {
    if (!color.startsWith("#") || color.length !== 7) return color;
    const n = parseInt(color.slice(1), 16);
    const r = clamp((n >> 16) + Math.round(255 * amount), 0, 255);
    const g = clamp(((n >> 8) & 255) + Math.round(255 * amount), 0, 255);
    const b = clamp((n & 255) + Math.round(255 * amount), 0, 255);
    return `rgb(${r},${g},${b})`;
  }

  function drawCharacter(x, y, facing, color, alpha = 1, boosted = false) {
    const sx = x - game.camera.x;
    const sy = y - game.camera.y;
    ctx.save(); ctx.globalAlpha = alpha;
    if (boosted) { ctx.shadowColor = "#6dffcf"; ctx.shadowBlur = 22; }
    ctx.translate(sx, sy);
    ctx.scale(facing, 1);
    ctx.fillStyle = "rgba(0,0,0,.2)"; ctx.beginPath(); ctx.ellipse(0, 27, 24, 8, 0, 0, TAU); ctx.fill();
    ctx.fillStyle = color; roundedRect(-16, -16, 32, 35, 8); ctx.fill();
    ctx.fillStyle = shadeColor(color, -.17); roundedRect(-15, 14, 12, 22, 5); ctx.fill(); roundedRect(3, 14, 12, 22, 5); ctx.fill();
    ctx.fillStyle = "#ffe0bd"; roundedRect(-14, -34, 28, 22, 8); ctx.fill();
    ctx.fillStyle = "#251c2a"; roundedRect(-15, -39, 30, 12, 7); ctx.fill();
    ctx.fillStyle = "#1a1620"; ctx.fillRect(4, -28, 4, 4);
    ctx.strokeStyle = "#8e4c45"; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(5, -20, 5, .1, 1.2); ctx.stroke();
    ctx.restore();
  }

  function drawWorld(time) {
    const level = game.level;
    const p = game.player;
    if (!level || !p) return;
    drawBackground(level.background, time);

    if (game.mapId === "lava") {
      ctx.fillStyle = "rgba(255,69,13,.12)";
      for (let i = 0; i < 8; i++) {
        const x = 80 + i * 165;
        ctx.fillRect(x, 0, 42, H);
      }
    }

    for (const platform of level.platforms) drawPlatform(platform, time);

    for (const trail of p.trail) {
      const alpha = clamp(trail.life, 0, 1) * (p.boostTimer > 0 ? .35 : .12);
      drawCharacter(trail.x, trail.y, p.facing, game.mapId === "lava" ? "#ff9a2f" : game.mapId === "sky" ? "#5dffbd" : "#ff55ad", alpha, false);
    }
    drawCharacter(p.x, p.y, p.facing, game.mapId === "lava" ? "#ffae35" : game.mapId === "sky" ? "#55e5ff" : "#ff56b2", p.invincible > 0 && Math.floor(p.invincible * 16) % 2 ? .45 : 1, p.boostTimer > 0);

    for (const particle of game.particles) {
      const s = platformScreen(particle);
      ctx.globalAlpha = clamp(particle.life / particle.maxLife, 0, 1);
      ctx.fillStyle = particle.color;
      ctx.beginPath(); ctx.arc(s.x, s.y, particle.size, 0, TAU); ctx.fill();
    }
    ctx.globalAlpha = 1;

    if (game.mapId === "lava") {
      const height = Math.max(0, Math.floor((610 - p.y) / 10));
      ctx.fillStyle = "rgba(0,0,0,.38)"; roundedRect(18, H - 72, 165, 48, 16); ctx.fill();
      ctx.fillStyle = "white"; ctx.font = "900 13px system-ui"; ctx.textAlign = "left"; ctx.fillText(`현재 높이 ${height}m`, 35, H - 43);
    }
  }

  function drawConfetti() {
    for (const c of game.confetti) {
      ctx.save(); ctx.translate(c.x, c.y); ctx.rotate(c.rot); ctx.fillStyle = c.color; ctx.fillRect(-c.size / 2, -c.size / 2, c.size, c.size * .65); ctx.restore();
    }
  }

