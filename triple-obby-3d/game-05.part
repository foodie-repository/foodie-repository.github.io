
    function updatePlatforms(dt, t) {
      if (!state.level) return;
      state.level.platforms.forEach(p => {
        if (p.kind === 'crumble' && !p.active && t >= p.respawnAt) {
          p.active = true;
          p.mesh.visible = true;
          p.mesh.material.opacity = 1;
          p.mesh.material.transparent = false;
          if (p.cracks) p.cracks.visible = true;
        }
        if (p.kind === 'crumble' && p.timer > 0 && p.active) {
          p.timer -= dt;
          const ratio = Math.max(0, p.timer / 0.6);
          p.mesh.material.transparent = true;
          p.mesh.material.opacity = 0.35 + ratio * 0.65;
          if (p.cracks) p.cracks.material.opacity = 0.35 + (1 - ratio) * 0.5;
          if (p.timer <= 0) {
            p.active = false;
            p.mesh.visible = false;
            p.respawnAt = t + 2.5;
            p.timer = 0;
          }
        }
        if (p.kind === 'boost') {
          const k = 0.92 + Math.sin(t * 5 + p.x) * 0.04;
          p.mesh.scale.set(1, k, 1);
        }
      });
    }

    function withinTop(p, x, z, radius = player.radius) {
      return x + radius > p.mesh.position.x - p.w / 2 && x - radius < p.mesh.position.x + p.w / 2 && z + radius > p.mesh.position.z - p.d / 2 && z - radius < p.mesh.position.z + p.d / 2;
    }

    function movementVector(dt) {
      const worldMove = new THREE.Vector3(
        (input.right ? 1 : 0) - (input.left ? 1 : 0),
        0,
        (input.back ? 1 : 0) - (input.forward ? 1 : 0),
      );
      if (worldMove.lengthSq() > 0) worldMove.normalize();

      const relative = globalThis.TripleObbyControls.stepArrowControls(arrowInput, player.yaw, dt);
      player.yaw = relative.yaw;
      const move = worldMove.add(new THREE.Vector3(relative.moveX, 0, relative.moveZ));
      if (move.lengthSq() > 1) move.normalize();
      return move;
    }

    function updatePlayer(dt) {
      if (!state.level) return;
      const level = state.level;
      const prevPos = player.pos.clone();
      const move = movementVector(dt);
      let speed = input.sprint ? 9.8 : 7.2;
      if (player.boost > 0) speed = 13.5;
      const target = move.multiplyScalar(speed);
      player.vel.x += (target.x - player.vel.x) * Math.min(1, dt * 11);
      player.vel.z += (target.z - player.vel.z) * Math.min(1, dt * 11);
      if (move.lengthSq() === 0) {
        player.vel.x *= Math.max(0, 1 - dt * 8);
        player.vel.z *= Math.max(0, 1 - dt * 8);
      }

      player.coyote = player.grounded ? 0.12 : Math.max(0, player.coyote - dt);
      player.jumpBuffer = input.jumpPressed ? 0.14 : Math.max(0, player.jumpBuffer - dt);
      if (player.jumpBuffer > 0 && player.coyote > 0) {
        player.vel.y = 9.8;
        player.grounded = false;
        player.coyote = 0;
        player.jumpBuffer = 0;
      }
      player.boost = Math.max(0, player.boost - dt);
      player.vel.y -= 24 * dt;
      player.vel.y = Math.max(-28, player.vel.y);

      player.pos.x += player.vel.x * dt;
      player.pos.z += player.vel.z * dt;
      player.pos.y += player.vel.y * dt;
      player.grounded = false;

      level.platforms.forEach(p => {
        if (!p.active) return;
        const top = p.mesh.position.y + p.h / 2;
        const prevBottom = prevPos.y;
        const nowBottom = player.pos.y;
        const inside = withinTop(p, player.pos.x, player.pos.z);
        if (inside && prevBottom >= top && nowBottom <= top && player.vel.y <= 0) {
          player.pos.y = top;
          player.vel.y = 0;
          player.grounded = true;
          if (p.kind === 'checkpoint') activateCheckpoint(p);
          if (p.kind === 'finish' && player.finishCooldown <= 0) { player.finishCooldown = 1; finishMap(); }
          if (p.kind === 'crumble' && p.timer <= 0) p.timer = 0.6;
          if (p.kind === 'boost') { player.boost = 1.2; showToast('가속 패드!', 0.55); }
        }
      });

      if (player.pos.y < level.killY) respawn('바닥 킬존에 떨어졌습니다');
      playerGroup.position.set(player.pos.x, player.pos.y, player.pos.z);
      if (!arrowFacingMode && (player.vel.x || player.vel.z)) {
        player.yaw = Math.atan2(player.vel.x, player.vel.z);
      }
      playerGroup.rotation.y = player.yaw;
      const swing = state.elapsed * 10;
      const amp = player.grounded && (Math.abs(player.vel.x) + Math.abs(player.vel.z)) > 0.2 ? 0.55 : 0;
      leg1.rotation.x = Math.sin(swing) * amp;
      leg2.rotation.x = -Math.sin(swing) * amp;
      bodyMat.emissive.set(player.boost > 0 ? 0x44ffae : 0x000000);
      bodyMat.emissiveIntensity = player.boost > 0 ? 0.45 : 0;
      input.jumpPressed = false;
    }

    function updateLobby(dt, t) {
      const portals = state.level.portals;
      const move = movementVector(dt);
      player.vel.x += (move.x * 7 - player.vel.x) * Math.min(1, dt * 10);
      player.vel.z += (move.z * 7 - player.vel.z) * Math.min(1, dt * 10);
      if (move.lengthSq() === 0) { player.vel.x *= Math.max(0, 1 - dt * 8); player.vel.z *= Math.max(0, 1 - dt * 8); }
      player.coyote = player.grounded ? 0.12 : Math.max(0, player.coyote - dt);
      if (input.jumpPressed && player.coyote > 0) { player.vel.y = 9.5; player.grounded = false; }
      input.jumpPressed = false;
      player.vel.y -= 24 * dt;
      player.pos.addScaledVector(player.vel, dt);
      if (player.pos.y <= 0) { player.pos.y = 0; player.vel.y = 0; player.grounded = true; }
      playerGroup.position.set(player.pos.x, player.pos.y, player.pos.z);
      if (!arrowFacingMode && (player.vel.x || player.vel.z)) player.yaw = Math.atan2(player.vel.x, player.vel.z);
      playerGroup.rotation.y = player.yaw;