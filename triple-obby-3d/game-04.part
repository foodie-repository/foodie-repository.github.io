      const islands = [
        [6, 2, -2], [12, 3, 2], [19, 5, -3], [27, 7, 3], [34, 8.5, -2],
        [42, 10, 4], [51, 12.2, -4], [61, 13.8, 3], [72, 15.8, -1], [84, 18, 3],
        [97, 20, -3], [111, 22.5, 4], [126, 24, 0]
      ];
      let stage = 1;
      islands.forEach((p, idx) => {
        const [x, y, z] = p;
        const islandW = idx % 3 === 0 ? 6.5 : 5.2;
        const islandD = idx % 2 === 0 ? 5.7 : 4.8;
        makePlatform(level, x, y, z, islandW, 0.7, islandD, 'solid', { color: idx % 2 ? 0xffffff : 0xe6fbff });
        const underside = makeBox(new THREE.Vector3(islandW * 0.72, 2.0, islandD * 0.72), 0x7b6d5f, new THREE.Vector3(x, y - 1.45, z), { roughness: 0.95 });
        underside.scale.x = 0.9; underside.scale.z = 0.9;
        level.group.add(underside);

        if ([2, 5, 8, 11].includes(idx)) {
          stage += 4;
          makePlatform(level, x + 3.6, y + 0.7, z + 2.8, 4.2, 0.55, 4.2, 'checkpoint', { stage: Math.min(stage, 20), color: 0x50e0ff });
        }
        if ([3, 6, 10].includes(idx)) {
          makePlatform(level, x + 5.2, y + 0.4, z - 3.2, 3.3, 0.45, 3.3, 'crumble', { color: 0xb6f6ff });
          makePlatform(level, x + 8.6, y + 1.2, z - 0.2, 3.3, 0.45, 3.3, 'crumble', { color: 0xdffcff });
        }
        if ([4, 9].includes(idx)) {
          makePlatform(level, x + 5.6, y + 0.2, z + 4.4, 4.4, 0.45, 4.4, 'boost', { color: 0x63ffbf });
        }
      });
      const cloudSteps = [
        [15, 4.2, -5], [22, 5.4, -6.6], [30, 8.5, 6], [48, 11.2, 6.8], [68, 15.2, 5.5], [103, 21.1, 6.5]
      ];
      cloudSteps.forEach((p, i) => {
        const cloud = buildCloud(new THREE.Vector3(p[0], p[1], p[2]), 1.25 + (i % 2) * 0.15);
        level.group.add(cloud);
        makePlatform(level, p[0], p[1] - 0.25, p[2], 4.2, 0.35, 3.7, i % 2 ? 'crumble' : 'solid', { color: 0xf4feff });
      });
      makePlatform(level, 139, 26.5, 0, 7.4, 0.7, 7.4, 'finish', { color: 0xffef6d, label: 'GOAL' });
      const voidFloor = makeBox(new THREE.Vector3(220, 0.4, 70), 0xff3d5f, new THREE.Vector3(70, -10.5, 0), { roughness: 0.25, opacity: 0.92, transparent: true });
      voidFloor.material.emissive = new THREE.Color(0xff3d5f);
      voidFloor.material.emissiveIntensity = 0.7;
      level.group.add(voidFloor);

      for (let i = 0; i < 28; i++) {
        level.group.add(buildCloud(new THREE.Vector3(-8 + i * 6 + Math.random() * 8, 7 + Math.random() * 20, -18 + Math.random() * 36), 1.4 + Math.random() * 0.9));
      }
      return level;
    }

    function startMap(id) {
      clearLevel();
      let level;
      if (id === 'color') level = buildColorMap();
      else if (id === 'lava') level = buildLavaMap();
      else level = buildSkyMap();
      worldRoot.add(level.group);
      state.level = level;
      state.mode = 'playing';
      state.elapsed = 0;
      player.mapId = id;
      player.pos.copy(level.spawn);
      player.vel.set(0, 0, 0);
      player.checkpoint.copy(level.spawn);
      player.stage = 1;
      player.boost = 0;
      player.finishCooldown = 0;
      mapName.textContent = MAPS[id].name;
      mapDesc.textContent = MAPS[id].desc;
      stageText.textContent = '1 / ' + MAPS[id].stages;
      timerText.textContent = fmt(0);
      bestText.textContent = fmt(getBest(id));
      hud.dataset.visible = 'true';
      lobbyOverlay.dataset.visible = 'false';
      mobileControls.dataset.visible = 'true';
      finishOverlay.dataset.visible = 'false';
      showToast(MAPS[id].name + ' 시작', 1.2);
    }

    function returnLobby() {
      state.mode = 'lobby';
      buildLobby();
    }

    function respawn(text) {
      player.pos.copy(player.checkpoint);
      player.vel.set(0, 0, 0);
      player.grounded = false;
      player.boost = 0;
      showToast(text || '체크포인트에서 다시 시작', 0.85);
    }

    function finishMap() {
      if (state.mode !== 'playing' || !player.mapId) return;
      state.mode = 'finish';
      const timeMs = state.elapsed * 1000;
      const oldBest = getBest(player.mapId);
      const best = setBest(player.mapId, timeMs);
      resultTime.textContent = fmt(timeMs);
      resultBest.textContent = fmt(best);
      finishMessage.textContent = timeMs < oldBest ? '새로운 최고 기록입니다.' : '멋지게 완주했습니다.';
      finishOverlay.dataset.visible = 'true';
      mobileControls.dataset.visible = 'false';
      bestText.textContent = fmt(best);
      for (let i = 0; i < 90; i++) {
        const mesh = new THREE.Mesh(particleGeo, new THREE.MeshBasicMaterial({ color: new THREE.Color().setHSL(Math.random(), 0.9, 0.6) }));
        mesh.position.set(player.pos.x + (Math.random() - 0.5) * 2, player.pos.y + 2 + Math.random() * 2, player.pos.z + (Math.random() - 0.5) * 2);
        scene.add(mesh);
        state.confetti.push({ mesh, vel: new THREE.Vector3((Math.random() - 0.5) * 6, Math.random() * 5 + 2, (Math.random() - 0.5) * 6), life: 2.8 + Math.random() * 1.8 });
      }
    }

    function activateCheckpoint(p) {
      if (p.stage > player.stage) {
        player.stage = p.stage;
        player.checkpoint.set(p.mesh.position.x, p.mesh.position.y + 1.7, p.mesh.position.z);
        stageText.textContent = Math.min(player.stage, MAPS[player.mapId].stages) + ' / ' + MAPS[player.mapId].stages;
        showToast('체크포인트 ' + player.stage, 0.9);
      }
    }
