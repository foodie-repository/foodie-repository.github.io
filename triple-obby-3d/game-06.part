      portals.forEach((p, i) => {
        p.ring.rotation.z += dt * 0.6;
        p.ring.material.emissiveIntensity = 0.6 + Math.sin(t * 2 + i) * 0.25;
        const dx = player.pos.x - p.x;
        const dz = player.pos.z - p.z;
        const dist = Math.hypot(dx, dz);
        if (dist < 2.5 && Math.abs(player.pos.y - 0) < 2.2) {
          showToast('포털에 닿았습니다. 버튼을 누르거나 그대로 진입하세요.', 0.2);
          if (dist < 1.3) startMap(p.id);
        }
      });
    }

    function updateCamera(dt) {
      const follow = player.pos.clone();
      const behind = new THREE.Vector3(Math.sin(player.yaw) * 7.5, 5.5, Math.cos(player.yaw) * 7.5);
      const targetPos = follow.clone().add(behind);
      camera.position.lerp(targetPos, 1 - Math.pow(0.003, dt));
      state.cameraTarget.lerp(follow.clone().add(new THREE.Vector3(0, 1.7, 0)), 1 - Math.pow(0.002, dt));
      camera.lookAt(state.cameraTarget);
    }

    function updateConfetti(dt) {
      state.confetti.forEach(c => {
        c.life -= dt;
        c.vel.y -= 8 * dt;
        c.mesh.position.addScaledVector(c.vel, dt);
      });
      const remain = [];
      state.confetti.forEach(c => {
        if (c.life > 0) remain.push(c); else scene.remove(c.mesh);
      });
      state.confetti = remain;
    }

    function animate() {
      requestAnimationFrame(animate);
      const now = performance.now() / 1000;
      const dt = Math.min(0.033, Math.max(0.001, now - state.lastTime));
      state.lastTime = now;
      hideToastIfNeeded(now);
      if (state.mode === 'playing') {
        state.elapsed += dt;
        updatePlatforms(dt, state.elapsed);
        updatePlayer(dt);
        timerText.textContent = fmt(state.elapsed * 1000);
      } else if (state.mode === 'lobby') {
        updateLobby(dt, now);
      }
      updateCamera(dt);
      updateConfetti(dt);
      renderer.render(scene, camera);
    }

    function bindKey(name, pressed) {
      if (name === 'w') input.forward = pressed;
      else if (name === 's') input.back = pressed;
      else if (name === 'a') input.left = pressed;
      else if (name === 'd') input.right = pressed;
      else if (name === 'jump') {
        if (pressed && !input.jump) input.jumpPressed = true;
        input.jump = pressed;
      } else if (name === 'sprint') input.sprint = pressed;
    }
    addEventListener('keydown', e => {
      if (['KeyW','ArrowUp'].includes(e.code)) bindKey('w', true);
      if (['KeyS','ArrowDown'].includes(e.code)) bindKey('s', true);
      if (['KeyA','ArrowLeft'].includes(e.code)) bindKey('a', true);
      if (['KeyD','ArrowRight'].includes(e.code)) bindKey('d', true);
      if (e.code === 'Space') { bindKey('jump', true); e.preventDefault(); }
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') bindKey('sprint', true);
      if (e.code === 'KeyR' && state.mode === 'playing') startMap(player.mapId);
      if ((e.code === 'KeyL' || e.code === 'Escape') && state.mode !== 'lobby') returnLobby();
    });
    addEventListener('keyup', e => {
      if (['KeyW','ArrowUp'].includes(e.code)) bindKey('w', false);
      if (['KeyS','ArrowDown'].includes(e.code)) bindKey('s', false);
      if (['KeyA','ArrowLeft'].includes(e.code)) bindKey('a', false);
      if (['KeyD','ArrowRight'].includes(e.code)) bindKey('d', false);
      if (e.code === 'Space') bindKey('jump', false);
      if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') bindKey('sprint', false);
    });
    addEventListener('blur', () => {
      Object.keys(input).forEach(k => input[k] = false);
      input.jumpPressed = false;
    });

    document.querySelectorAll('.portalBtn').forEach(btn => btn.addEventListener('click', () => startMap(btn.dataset.map)));
    document.getElementById('restartBtn').addEventListener('click', () => { if (player.mapId) startMap(player.mapId); });
    document.getElementById('lobbyBtn').addEventListener('click', returnLobby);
    document.getElementById('retryFinishBtn').addEventListener('click', () => { if (player.mapId) startMap(player.mapId); });
    document.getElementById('lobbyFinishBtn').addEventListener('click', returnLobby);

    document.querySelectorAll('[data-key]').forEach(btn => {
      const key = btn.dataset.key;
      const down = e => {
        e.preventDefault();
        if (key === 'jump') bindKey('jump', true);
        else input[key] = true;
        if (btn.setPointerCapture && e.pointerId !== undefined) btn.setPointerCapture(e.pointerId);
      };
      const up = e => {
        e.preventDefault();
        if (key === 'jump') bindKey('jump', false);
        else input[key] = false;
      };
      btn.addEventListener('pointerdown', down, { passive: false });
      btn.addEventListener('pointerup', up, { passive: false });
      btn.addEventListener('pointercancel', up, { passive: false });
      btn.addEventListener('pointerleave', e => { if (e.buttons === 0) up(e); }, { passive: false });
    });

    addEventListener('resize', () => {
      camera.aspect = innerWidth / innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(innerWidth, innerHeight);
    });

    buildLobby();
    animate();
    window.__TRIPLE_OBBY_3D__ = { startMap, returnLobby };
  })();
  
